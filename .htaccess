<IfModule mod_rewrite.c>

RewriteEngine On

# redirect all subdomains to http://www.pouet.net

RewriteCond %{HTTPS} ^off$ [NC]
RewriteCond %{HTTP_HOST} =pouet.net [OR]
RewriteCond %{HTTP_HOST} =pouet.scene.org [OR]
RewriteCond %{HTTP_HOST} =www.pouet.scene.org
RewriteRule ^(.*)$ http://www.pouet.net/$1 [R=301,QSA,NE,L]

RewriteCond %{HTTPS} ^on$ [NC]
RewriteCond %{HTTP_HOST} =pouet.net [OR]
RewriteCond %{HTTP_HOST} =pouet.scene.org [OR]
RewriteCond %{HTTP_HOST} =www.pouet.scene.org
RewriteRule ^(.*)$ https://www.pouet.net/$1 [R=301,QSA,NE,L]


# redirect all old directories to content domain

RewriteRule ^avatars\/(.*)$ https://content.pouet.net/avatars/$1 [R=301,L]
RewriteRule ^screenshots\/(.*)$ https://content.pouet.net/screenshots/$1 [R=301,L]


# maintenance mode, if needed

# RewriteCond %{REMOTE_ADDR} !^188\.142\.212\.47
# RewriteRule .* http://content.pouet.net/maintenance.html [R=302,L]


# block users

#RewriteCond %{REMOTE_ADDR} ^5\.9\.55\.166 [OR]
#RewriteCond %{REMOTE_ADDR} ^47\.76\.
RewriteCond %{REMOTE_ADDR} ^94\.31\.89\.23
#RewriteCond %{REMOTE_ADDR} ^47\.128\.
RewriteRule .* - [F]

</IfModule>

# Prevent clickjacking by disallowing framing of the site
Header always set X-Frame-Options "DENY"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Content-Security-Policy "upgrade-insecure-requests"

# Internal code and data, never served directly: PHP here only works when
# included, bin/ holds maintainer scripts and cache/ runtime cache files
RedirectMatch 404 (?i)^/(bin|cache|include_generic|include_pouet|include_pouet_index)(/|$)
RedirectMatch 404 (?i)^/admin\.functions\.php(/|$)

# Uploads live on content.pouet.net only, so they never run on www's origin.
# Old /content/ links (from when www served them) go there. RedirectMatch,
# not RewriteRule: if a content/ directory exists, its own .htaccess rewrite
# rules replace these ones
RedirectMatch 301 ^/content(/.*)?$ https://content.pouet.net$1
